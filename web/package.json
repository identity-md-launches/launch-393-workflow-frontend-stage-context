{
  "name": "trickle-staking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/export.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node tests/interactions.mjs",
    "verify": "node scripts/export.mjs --check",
    "check:rpc": "node scripts/check-rpc.mjs",
    "format": "prettier --write src tests scripts index.html vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.56.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
